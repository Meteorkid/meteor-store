# Asia/Shanghai：独立博士任务，避开硕士同步时点；复用既有调度密钥。
20 8,14 * * * /usr/bin/flock -n /run/lock/meteor-phd-sync.lock /usr/local/bin/node --env-file=/var/www/meteor-store/.env.production /var/www/meteor-store/scripts/phd-sync-cron.mjs 2>&1 | /usr/bin/logger -t meteor-phd-sync
5 9,15 * * * /usr/bin/flock -n /run/lock/meteor-phd-deadlines.lock /usr/local/bin/node --env-file=/var/www/meteor-store/.env.production /var/www/meteor-store/scripts/phd-deadlines-cron.mjs 2>&1 | /usr/bin/logger -t meteor-phd-deadlines
