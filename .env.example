# ==========================================
# 环境变量配置
# ==========================================

# ---------- Database (Neon PostgreSQL) ----------
# 从 Neon 控制台获取: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ---------- Alipay (支付宝) ----------
# 沙箱环境: https://open.alipay.com/develop/sandbox
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 沙箱: https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 正式: https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_SELLER_ID=

# ---------- WeChat Pay (微信支付, API v3) ----------
# 需用个体工商户/企业执照开通微信支付商户号，再在商户平台获取以下值。
# 接入文档: https://pay.weixin.qq.com/docs/merchant/development/interface-rules/introduction.html
WECHAT_MCHID=            # 商户号
WECHAT_APPID=            # 关联的公众号/小程序 AppID
WECHAT_PRIVATE_KEY=      # 商户 API 私钥（PKCS#8 PEM）
WECHAT_SERIAL_NO=        # 商户证书序列号
WECHAT_API_V3_KEY=       # API v3 密钥（32 位字符）
# 平台公钥模式：下载「平台公钥」(PUB_KEY_ID_xxx) 填 content，并填其 Public Key ID
WECHAT_PLATFORM_PUBLIC_KEY=  # 平台公钥 PEM 内容（验证回调/响应）
WECHAT_PLATFORM_PUBLIC_KEY_ID=  # 平台公钥的 Public Key ID（PUB_KEY_ID_xxx，可选）
WECHAT_PLATFORM_PUBLIC_KEY_ID=  # 平台公钥的 Public Key ID（PUB_KEY_ID_xxx，可选）

# ---------- WeChat OAuth Login (微信开放平台网站应用扫码登录) ----------
# 需在 open.weixin.qq.com 创建「网站应用」，授权回调域填 www.imagentx.top。
# 与上方微信支付配置刻意分开：扫码登录必须用网站应用的 appid/secret。
WECHAT_WEB_APPID=        # 开放平台网站应用 AppID（不填则回退 WECHAT_APPID）
WECHAT_WEB_APPSECRET=    # 开放平台网站应用 AppSecret（必须显式配置，否则扫码登录入口显示未配置）

# ---------- Email (Resend) ----------
# 注册: https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
# 用户回复验证/订单邮件时实际收件的邮箱
RESEND_REPLY_TO_EMAIL=
RESEND_AUDIENCE_ID=

# ---------- Delivery Retry ----------
# 用于手动触发邮件补发的 API token
DELIVERY_RETRY_SECRET=

# ---------- Pathfinder 信息聚合 ----------
# 服务器 crontab 调用 POST /api/cron/pathfinder-sync 时使用，至少 32 字节随机值。
# 未配置时同步接口始终返回 401；公开页面仍可使用仓库内的可信种子目录。
# 生产环境使用下方 REDIS_URL 指向本机 Redis，用于静态种子紧急下架保护。
PATHFINDER_CRON_SECRET=
# 可选。GitHub Search API 不带令牌也可用，但额度很低；只需公开信息只读权限。
GITHUB_TOKEN=

# ---------- Admin Alert ----------
# 支付宝通知金额异常等严重问题的告警接收邮箱；不配置则跳过告警
ALERT_EMAIL=

# ---------- Avatar Object Storage (Cloudflare R2) ----------
# 头像走对象存储，避免 users.avatar_url 存 base64 data URL 膨胀数据库。
# 全部留空时，头像会降级为 data URL 入库（开发环境够用，生产不建议）。
#
# 在 Cloudflare R2 控制台创建 bucket 后：
#   1. 给 bucket 绑定一个公开访问的自定义域名（如 https://cdn.imagentx.top）
#   2. 在 R2 > Manage R2 API Tokens 创建 token，需要覆盖
#      avatars/*、blog/* 两个前缀（安装包走下面的私有 bucket，不在此公开 bucket）
#   3. 把以下 5 个值填到 .env.local
#
# 公开 bucket 只承载头像（avatars/）与博客图片（blog/）：
#   avatars/*   头像（公开）
#   blog/*      博客图片（公开）
#
# R2_PUBLIC_BASE 是公开对象的对外前缀，必须和 bucket 绑定的自定义域名一致，
# 不要带末尾斜杠。中间件会读取它注入到 CSP img-src 白名单。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=

# ---------- Release Object Storage (Cloudflare R2, 私有) ----------
# 安装包（releases/）专用私有 bucket，与公开 bucket 完全隔离。
#
# 该 bucket 必须保持私有：不绑定公开域名、不开 r2.dev 公共入口。
# 所有安装包（含免费产品）都只通过 /api/download[productId] 签发的
# 短时效预签名 URL 下载，猜中对象路径也拖不走。
#
# 复用上方同一个 R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY，
# 只需指定私有 bucket 名。上传用 scripts/upload-release.mjs。
R2_RELEASE_BUCKET=

# ---------- Rate Limit / CAPTCHA (本机 Redis) ----------
# 生产环境在服务器 127.0.0.1 上运行 redis-server，只监听回环地址并开启 requirepass。
# 应用通过一个标准 Redis URL 连接，不再使用 Upstash 的 HTTP REST 接口：
#   REDIS_URL=redis://:password@127.0.0.1:6379/0
#
# 未配置时：限流按调用方声明降级为进程内内存（或直接放行），CAPTCHA 走进程内 Map。
# 生产环境必须配置，否则 login/register 等接口失去跨重启的限流保护。
REDIS_URL=

# ---------- Error Monitoring (Sentry) ----------
# DSN 不是密钥，本来就会嵌进客户端包，可以公开
# 未配置时 Sentry 不初始化，应用照常运行
NEXT_PUBLIC_SENTRY_DSN=
# 可选：配上之后构建时会上传 source map，Sentry 里的堆栈才能映射回源码。
# 这个是密钥，不要提交进仓库。在 https://sentry.io/settings/account/api/auth-tokens/ 生成
SENTRY_AUTH_TOKEN=

# ---------- Auth (JWT) ----------
# 用于签发登录 session token，至少 32 位随机字符
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---------- Admin MFA (TOTP) ----------
# 管理员两步验证的 secret 落库加密密钥，至少 32 位随机字符
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 必须与 JWT_SECRET 分开，且**一旦有人绑定了两步验证就不能再换**：
# 换了之后已绑定的 TOTP 密文永久解不开，只能靠恢复码找回并重新绑定。
# 未配置时会退回用 JWT_SECRET 派生（仅为兼容存量数据），生产环境请配上——
# 否则轮换 JWT_SECRET 会顺带废掉所有人的两步验证。
TOTP_ENC_KEY=

# ---------- Site ----------
# 本地开发: http://localhost:3000
# 生产环境: https://www.imagentx.top
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Feature Flags ----------
# ICP 备案期间设为 false，隐藏所有销售界面；备案通过后改为 true
NEXT_PUBLIC_SHOW_PRICING=false

# ---------- 搜索引擎站长验证 ----------
# 三家都用「HTML 标签」验证方式：在各自后台添加站点后会给一段
# <meta name="..." content="XXX">，把其中的 content 值填到这里（不要带尖括号）。
# 没配的那家不会输出标签——挂空值会被判定验证失败，比没有更糟。
#
# 这些值不是密钥（本来就公开在页面源码里），但仍走环境变量，
# 免得换域名或重新验证时要改代码。
#
# 改完必须重新 pnpm build 再重启，metadata 不是热更新的。
#
# Google Search Console: https://search.google.com/search-console
GOOGLE_SITE_VERIFICATION=
# Bing 网站管理员工具: https://www.bing.com/webmasters
BING_SITE_VERIFICATION=
# 百度搜索资源平台: https://ziyuan.baidu.com/site/index
BAIDU_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# 主动推送（内容变了立刻通知搜索引擎，不必干等爬虫回来）
#
# 与上面的验证标签是两回事：验证只证明「这站是我的」，推送才是真的把地址送过去。
# 没配的那家自动跳过，不会报错。Google 没有等价接口，只能靠 sitemap + Search Console。
#
# IndexNow（Bing / Yandex / Seznam 共用）：自己生成一个 8–128 位十六进制字符串，
# 例如 `openssl rand -hex 16`。**填好后必须能从
# https://www.imagentx.top/indexnow-key.txt 原样读到**（由 route handler 下发，
# 值就取自这个变量，所以不会对不上），Bing 收到推送会来核对，对不上整批丢弃。
INDEXNOW_KEY=
# 百度普通收录：站长平台 → 普通收录 → API 提交 里给的 token。
# **每天有推送配额**，超了返回 over_quota，所以别拿脚本反复推同一批地址。
BAIDU_PUSH_TOKEN=
# Ex-Memory 同机 Nginx auth_request 使用的服务间密钥（至少 32 字节随机值）
# EX_MEMORY_PROXY_TOKEN=

# DeepSeek API（Pathfinder 的 AI 动态解读；未配置时该功能显示为未启用）
# 生产服务器在阿里云，实测 api.anthropic.com 对该出口 IP 按地区拒绝，故用国内接口
DEEPSEEK_API_KEY=

# ---------- WeChat Official Account (微信公众号草稿箱) ----------
# 只用于管理后台的「公众号草稿同步」，不复用微信支付 / 开放平台扫码登录的凭据。
# 在公众号后台「开发与服务 → 基本配置」取 AppID / AppSecret（AppSecret 只完整显示一次）。
#
# 【必做】把应用服务器的公网出口 IP 加进同一页的「IP 白名单」，否则取 token 报 40164。
#   本站生产服务器出口 IP：8.138.218.165
# 【注意】access_token 全局唯一，别在别的脚本里对同一 AppID 重复获取，会互相顶掉；
#   管理端遇到 40001 / 42001 会自动刷新并重试一次，但频繁互顶仍会拖慢创建。
# 【权限】个人主体 / 未认证账号自 2025 年 7 月起无 freepublish 发布接口权限，
#   但 draft/add 草稿箱可用 —— 本功能只建草稿，最后一步在公众号后台手动点「发表」。
WECHAT_MP_APPID=
WECHAT_MP_APPSECRET=
# 无图文章或日刊的默认封面（站内 public 路径或 https 图片地址），默认 /og-image.png
WECHAT_MP_DEFAULT_COVER=/og-image.png
# 可选：在公众号后台上传一次封面后把永久素材 media_id 填这里，避免每篇都重复上传封面
# WECHAT_MP_COVER_MEDIA_ID=
