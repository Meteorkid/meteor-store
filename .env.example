# ==========================================
# 环境变量配置
# ==========================================

# ---------- Database (Neon PostgreSQL) ----------
# 从 Neon 控制台获取: https://console.neon.tech
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# ---------- Alipay (支付宝) ----------
# 沙箱环境: https://open.alipay.com/develop/sandbox
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
# 沙箱: https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 正式: https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_SELLER_ID=

# ---------- WeChat Pay (微信支付, API v3) ----------
# 需用个体工商户/企业执照开通微信支付商户号，再在商户平台获取以下值。
# 接入文档: https://pay.weixin.qq.com/docs/merchant/development/interface-rules/introduction.html
WECHAT_MCHID=            # 商户号
WECHAT_APPID=            # 关联的公众号/小程序 AppID
WECHAT_PRIVATE_KEY=      # 商户 API 私钥（PKCS#8 PEM）
WECHAT_SERIAL_NO=        # 商户证书序列号
WECHAT_API_V3_KEY=       # API v3 密钥（32 位字符）
# 平台公钥模式：下载「平台公钥」(PUB_KEY_ID_xxx) 填 content，并填其 Public Key ID
WECHAT_PLATFORM_PUBLIC_KEY=  # 平台公钥 PEM 内容（验证回调/响应）
WECHAT_PLATFORM_PUBLIC_KEY_ID=  # 平台公钥的 Public Key ID（PUB_KEY_ID_xxx，可选）

# ---------- Email (Resend) ----------
# 注册: https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@yourdomain.com
# 用户回复验证/订单邮件时实际收件的邮箱
RESEND_REPLY_TO_EMAIL=
RESEND_AUDIENCE_ID=

# ---------- Delivery Retry ----------
# 用于手动触发邮件补发的 API token
DELIVERY_RETRY_SECRET=

# ---------- Admin Alert ----------
# 支付宝通知金额异常等严重问题的告警接收邮箱；不配置则跳过告警
ALERT_EMAIL=

# ---------- Avatar Object Storage (Cloudflare R2) ----------
# 头像走对象存储，避免 users.avatar_url 存 base64 data URL 膨胀数据库。
# 全部留空时，头像会降级为 data URL 入库（开发环境够用，生产不建议）。
#
# 在 Cloudflare R2 控制台创建 bucket 后：
#   1. 给 bucket 绑定一个公开访问的自定义域名（如 https://cdn.imagentx.top）
#   2. 在 R2 > Manage R2 API Tokens 创建 token，需要覆盖
#      avatars/*、blog/* 两个前缀（安装包走下面的私有 bucket，不在此公开 bucket）
#   3. 把以下 5 个值填到 .env.local
#
# 公开 bucket 只承载头像（avatars/）与博客图片（blog/）：
#   avatars/*   头像（公开）
#   blog/*      博客图片（公开）
#
# R2_PUBLIC_BASE 是公开对象的对外前缀，必须和 bucket 绑定的自定义域名一致，
# 不要带末尾斜杠。中间件会读取它注入到 CSP img-src 白名单。
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=

# ---------- Release Object Storage (Cloudflare R2, 私有) ----------
# 安装包（releases/）专用私有 bucket，与公开 bucket 完全隔离。
#
# 该 bucket 必须保持私有：不绑定公开域名、不开 r2.dev 公共入口。
# 所有安装包（含免费产品）都只通过 /api/download[productId] 签发的
# 短时效预签名 URL 下载，猜中对象路径也拖不走。
#
# 复用上方同一个 R2_ACCOUNT_ID / R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY，
# 只需指定私有 bucket 名。上传用 scripts/upload-release.mjs。
R2_RELEASE_BUCKET=

# ---------- Rate Limit (Upstash Redis) ----------
# 分布式限流。两个都不配时限流会静默降级：
#   - 声明了 fallback: 'memory' 的接口退化为单实例内存限流（serverless 多实例下形同虚设）
#   - 其余接口直接不限流
# 生产环境必须配置，否则 login/register 等接口无实际防护
#
# 本地填这两个（值从 Upstash 控制台的 REST API 区块复制）：
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
#
# Vercel 上走 Marketplace 集成时无需手填：集成会注入
# UPSTASH_REDIS_KV_REST_API_URL / _TOKEN，代码会自动回退识别。
# 不要把集成注入的值手抄成上面两个名字——集成托管的变量在 token 轮换时会自动更新，
# 手抄的副本不会，限流会拿着作废 token 静默失效。

# ---------- Error Monitoring (Sentry) ----------
# DSN 不是密钥，本来就会嵌进客户端包，可以公开
# 未配置时 Sentry 不初始化，应用照常运行
NEXT_PUBLIC_SENTRY_DSN=
# 可选：配上之后构建时会上传 source map，Sentry 里的堆栈才能映射回源码。
# 这个是密钥，不要提交进仓库。在 https://sentry.io/settings/account/api/auth-tokens/ 生成
SENTRY_AUTH_TOKEN=

# ---------- Auth (JWT) ----------
# 用于签发登录 session token，至少 32 位随机字符
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# ---------- Admin MFA (TOTP) ----------
# 管理员两步验证的 secret 落库加密密钥，至少 32 位随机字符
# 生成: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# 必须与 JWT_SECRET 分开，且**一旦有人绑定了两步验证就不能再换**：
# 换了之后已绑定的 TOTP 密文永久解不开，只能靠恢复码找回并重新绑定。
# 未配置时会退回用 JWT_SECRET 派生（仅为兼容存量数据），生产环境请配上——
# 否则轮换 JWT_SECRET 会顺带废掉所有人的两步验证。
TOTP_ENC_KEY=

# ---------- Site ----------
# 本地开发: http://localhost:3000
# 生产环境: https://www.imagentx.top
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------- Feature Flags ----------
# ICP 备案期间设为 false，隐藏所有销售界面；备案通过后改为 true
NEXT_PUBLIC_SHOW_PRICING=false
